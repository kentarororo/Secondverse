{
  "name": "anotherverse-reimagined",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b",
    "typecheck:sim": "tsc -p tsconfig.sim.json",
